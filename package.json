{
  "name": "job-tracker",
  "version": "0.0.1",
  "private": true,
  "description": "Personal job application tracker",
  "workspaces": [
    "recruiter-frontend",
    "recruiter-backend",
    "packages/*"
  ],
  "scripts": {
    "prepare:hosted": "node scripts/prepare-hosted.cjs",
    "test:hosted": "node --test scripts/hosted.test.cjs",
    "test:pwa": "node --import tsx --test recruiter-frontend/lib/web-access-core.test.ts recruiter-frontend/lib/web-access-store.test.ts && node --test scripts/pwa.test.cjs scripts/release-files.test.cjs",
    "build:extension": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-extension.ps1",
    "build:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/build.ps1",
    "build:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/build-installer.ps1",
    "test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/verify.ps1",
    "test:postgres": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/verify-native-postgres.ps1",
    "test:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/verify-desktop.ps1",
    "test:installer": "node --test scripts/release-files.test.cjs && powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/verify-installer.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/verify-lifecycle.ps1",
    "start:windows": "powershell.exe -NoProfile -Command \"Start-Process -FilePath '.\\dist\\windows\\JobTracker.exe'\"",
    "dev:web": "npm run dev -w recruiter-frontend",
    "dev:worker": "npm run start:dev -w recruiter-backend",
    "build:shared": "npm run build -w @recruit/shared",
    "build": "npm run build:shared && npm run build -w recruiter-backend -w recruiter-frontend",
    "lint": "npm run lint --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "npm run prisma:migrate -w recruiter-backend",
    "db:deploy": "npm run prisma:deploy -w recruiter-backend",
    "db:seed": "npm run db:seed -w recruiter-backend",
    "db:studio": "npm run prisma:studio -w recruiter-backend"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
